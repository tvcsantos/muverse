{
  "name": "versu",
  "version": "3.0.1",
  "description": "Versu",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/action",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint 'packages/*/src/**/*.ts'",
    "format": "prettier --write packages/*/src/**/*.ts"
  },
  "keywords": [
    "versu",
    "github-action",
    "cli",
    "monorepo",
    "semantic-versioning",
    "conventional-commits",
    "version-engine",
    "dependency-cascade",
    "gradle",
    "jvm"
  ],
  "author": "tvcsantos",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.13.2",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "rollup": "^4.62.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "core-js@2.6.12": true,
    "fsevents@1.2.13": true,
    "fsevents@2.3.3": true
  }
}
