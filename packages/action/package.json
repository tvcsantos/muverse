{
  "name": "@versu/action",
  "version": "3.1.0",
  "description": "Versu (GitHub Action)",
  "type": "module",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/generate-version.mjs",
    "build": "npx rollup --config rollup.config.mjs && npm run copy-action-yml",
    "package": "npm run build",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write src/**/*.ts",
    "copy-action-yml": "node scripts/copy-action-yml.mjs"
  },
  "keywords": [
    "versu",
    "github-action",
    "semantic-versioning",
    "conventional-commits",
    "version-engine",
    "dependency-cascade",
    "gradle",
    "jvm"
  ],
  "author": "tvcsantos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/versuhq/versu.git",
    "directory": "packages/action"
  },
  "bugs": {
    "url": "https://github.com/versuhq/versu/issues"
  },
  "homepage": "https://github.com/versuhq/versu#readme",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@versu/core": "^3.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.13.2",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "rollup": "^4.62.2",
    "shx": "^0.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24"
  }
}
