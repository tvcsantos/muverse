{
  "name": "@versu/core",
  "version": "3.1.1",
  "description": "Versu (Core Library)",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "node scripts/generate-version.js",
    "build": "tsc --project tsconfig.json --outDir dist",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "versu",
    "core",
    "semantic-versioning",
    "conventional-commits",
    "version-engine",
    "dependency-cascade",
    "monorepo"
  ],
  "author": "tvcsantos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/versuhq/versu.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/versuhq/versu/issues"
  },
  "homepage": "https://github.com/versuhq/versu#readme",
  "files": [
    "dist"
  ],
  "types": "dist/index.d.ts",
  "dependencies": {
    "conventional-changelog-writer": "^8.4.0",
    "conventional-commits-parser": "^6.4.0",
    "cosmiconfig": "^9.0.2",
    "deepmerge": "^4.3.1",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "handlebars": "^4.7.9",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24"
  }
}
