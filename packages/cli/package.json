{
  "name": "@versu/cli",
  "version": "3.0.1",
  "description": "Versu (CLI)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "versu": "./bin/run.js"
  },
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "lint": "eslint 'src/**/*.ts'",
    "format": "prettier --write src/**/*.ts",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "oclif manifest && oclif readme",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "version": "oclif readme && git add README.md"
  },
  "keywords": [
    "oclif",
    "versu",
    "cli",
    "semantic-versioning",
    "conventional-commits",
    "version-engine",
    "monorepo"
  ],
  "author": "tvcsantos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/versuhq/versu.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/versuhq/versu/issues"
  },
  "homepage": "https://github.com/versuhq/versu#readme",
  "files": [
    "./bin",
    "./dist",
    "./oclif.manifest.json"
  ],
  "types": "dist/index.d.ts",
  "dependencies": {
    "@oclif/core": "^4.11.8",
    "@oclif/plugin-autocomplete": "^3.2.50",
    "@oclif/plugin-commands": "^4.1.59",
    "@oclif/plugin-help": "^6.2.52",
    "@oclif/plugin-not-found": "^3.2.88",
    "@oclif/plugin-search": "^1.2.50",
    "@oclif/plugin-version": "^2.2.49",
    "@oclif/plugin-warn-if-update-available": "^3.1.65",
    "@versu/core": "^3.0.1",
    "chalk": "^5.6.2",
    "debug": "^4.4.3",
    "ora": "^9.4.0"
  },
  "devDependencies": {
    "@oclif/test": "^4.1.19",
    "@types/debug": "^4.1.13",
    "@types/node": "^24.13.2",
    "oclif": "^4.23.16",
    "shx": "^0.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=24"
  },
  "oclif": {
    "bin": "versu",
    "dirname": "versu",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-not-found",
      "@oclif/plugin-commands",
      "@oclif/plugin-search",
      "@oclif/plugin-version",
      "@oclif/plugin-autocomplete"
    ],
    "topicSeparator": " ",
    "topics": {
      "plugin": {
        "description": "Manage Versu plugins"
      }
    }
  }
}
